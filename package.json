{
  "name": "cert-command-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm --prefix functions run typecheck",
    "seed": "tsx scripts/seed.ts",
    "seed:dry": "tsx scripts/seed.ts --dry-run",
    "test": "tsx scripts/progress.test.ts && tsx scripts/curriculum.test.ts && tsx scripts/access.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cert-rules \"tsx scripts/rules.test.ts\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-cert",
    "deploy": "npm run build && firebase deploy --only hosting",
    "env:write": "node scripts/write-env.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "verify": "npm run functions:install && npm run typecheck && npm test && npm run seed:dry && npm run build",
    "test:access": "tsx scripts/access.test.ts",
    "test:access:emu": "firebase emulators:exec --only firestore --project demo-cert-access \"tsx scripts/access.test.ts\"",
    "access": "tsx scripts/access-admin.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "functions:install": "npm --prefix functions ci",
    "deploy:functions": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase": "^10.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "firebase-admin": "^12.6.0",
    "firebase-tools": "^13.35.1",
    "postcss": "^8.4.47",
    "stripe": "^19.3.0",
    "tailwindcss": "^3.4.12",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
