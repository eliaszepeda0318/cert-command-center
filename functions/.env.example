# Non-secret function parameters. Copy to functions/.env.<your-project-id> (e.g. .env.cert-command-center-eli)
# Secrets (Stripe keys) are NOT set here; use `firebase functions:secrets:set` (see docs/paid-access.md).

# Stripe Price ID of the one-time $10 price (created by `npm run stripe:setup`). Not secret.
STRIPE_PRICE_ID=price_xxx
# Public URL of the hosted app. Checkout success/cancel URLs are built from this, never from client input.
APP_BASE_URL=https://YOUR-PROJECT-ID.web.app
# Keep false until App Check is confirmed working in production (see docs/paid-access.md).
ENFORCE_APP_CHECK=false
