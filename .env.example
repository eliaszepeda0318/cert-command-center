# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Set to true to use local emulators (auth 9099, firestore 8080)
VITE_USE_EMULATORS=false

# Seed script only (never prefixed with VITE_, never committed):
# FIREBASE_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# --- Paid access (optional until you launch) ---
# Public reCAPTCHA v3 site key from Firebase console > App Check > Apps. Public by design (not a secret). Leave blank to skip App Check.
VITE_APPCHECK_SITE_KEY=
# Set true ONLY on localhost to print an App Check debug token to register in the console.
VITE_APPCHECK_DEBUG=false
# Must match REGION in functions/src/config.ts
VITE_FUNCTIONS_REGION=us-central1
