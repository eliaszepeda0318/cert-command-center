rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Shared curriculum/reference data: readable by any signed-in user, written only by the
    // Admin SDK seed script (which bypasses rules). Clients can never write here.
    match /certifications/{id}          { allow read: if signedIn(); allow write: if false; }
    match /courses/{id}                 { allow read: if signedIn(); allow write: if false; }
    match /modules/{id}                 { allow read: if signedIn(); allow write: if false; }
    match /lessons/{id}                 { allow read: if signedIn(); allow write: if false; }
    match /labs/{id}                    { allow read: if signedIn(); allow write: if false; }
    match /topics/{id}                  { allow read: if signedIn(); allow write: if false; }
    match /blueprints/{id}              { allow read: if signedIn(); allow write: if false; }
    match /blueprintObjectives/{id}     { allow read: if signedIn(); allow write: if false; }
    match /lessonObjectiveMappings/{id} { allow read: if signedIn(); allow write: if false; }

    // Personal data: only the owner. Covers users/{uid} and every subcollection
    // (progress, studySessions, practiceExams, notes, workApplications, topicProgress).
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
