rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // ---- Paid access -------------------------------------------------------------------------------------------------
    // entitlements/{uid} is written ONLY by the Admin SDK (Cloud Functions webhook + owner admin script), never by a client.
    // Access = admin (never expires) OR status active/comped with a FUTURE accessExpiresAt. Expiry is judged against
    // request.time, so it takes effect the instant the date passes (no cron job needed). A missing doc = unpaid = no access.
    function entPath() { return /databases/$(database)/documents/entitlements/$(request.auth.uid); }
    function hasAccess() {
      return signedIn() && exists(entPath()) && (
        get(entPath()).data.status == 'admin' ||
        (get(entPath()).data.status in ['active', 'comped'] &&
         get(entPath()).data.accessExpiresAt is timestamp &&
         get(entPath()).data.accessExpiresAt > request.time));
    }

    // A user may read ONLY their own entitlement. No client write, ever (status, expiry, Stripe ids, seat flag).
    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
    // Seat-limit config (salesOpen, maxPaidUsers, currentPaidUsers, foundingPriceCents). Signed-in users may read it so the UI can
    // show "sold out"; nobody can write it from a client. Only the single document "access" is readable.
    match /appConfig/{id} {
      allow read: if signedIn() && id == 'access';
      allow write: if false;
    }
    // seatReservations/* and stripePayments/* are server-only: they fall through to the default deny at the bottom.

    // ---- Shared curriculum/reference data --------------------------------------------------------------------------
    // Part of the paid product: readable only with valid access. Written only by the Admin SDK seed script (clients never).
    match /certifications/{id}          { allow read: if hasAccess(); allow write: if false; }
    match /courses/{id}                 { allow read: if hasAccess(); allow write: if false; }
    match /modules/{id}                 { allow read: if hasAccess(); allow write: if false; }
    match /lessons/{id}                 { allow read: if hasAccess(); allow write: if false; }
    match /labs/{id}                    { allow read: if hasAccess(); allow write: if false; }
    match /topics/{id}                  { allow read: if hasAccess(); allow write: if false; }
    match /blueprints/{id}              { allow read: if hasAccess(); allow write: if false; }
    match /blueprintObjectives/{id}     { allow read: if hasAccess(); allow write: if false; }
    match /lessonObjectiveMappings/{id} { allow read: if hasAccess(); allow write: if false; }

    // ---- Personal data ---------------------------------------------------------------------------------------------
    // Owner-only. Reads stay open to the owner even after access lapses (you can always see your own history, and nothing is
    // ever deleted on expiry). WRITES require valid access, so unpaid or expired users cannot change progress.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && hasAccess();
      match /{document=**} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && hasAccess();
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
